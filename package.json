{
  "name": "suppress-exit-code",
  "version": "4.0.0",
  "description": "Cross-platform CLI wrapper that runs any command and exits with zero",
  "keywords": [
    "child-process",
    "cli",
    "cross-platform",
    "exit",
    "exit-code",
    "exit-status",
    "ignore",
    "lint-staged",
    "spawn",
    "suppress",
    "wrapper"
  ],
  "homepage": "https://github.com/kachkaev/suppress-exit-code#readme",
  "bugs": {
    "url": "https://github.com/kachkaev/suppress-exit-code/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kachkaev/suppress-exit-code.git"
  },
  "license": "MIT",
  "author": {
    "name": "Alexander Kachkaev",
    "email": "alexander@kachkaev.ru",
    "url": "https://en.kachkaev.ru"
  },
  "type": "module",
  "bin": "main.js",
  "files": [
    "LICENSE.md",
    "README.md",
    "main.js"
  ],
  "scripts": {
    "changesets:publish": "changeset publish",
    "changesets:version": "changeset version",
    "fix": "npm-run-all --continue-on-error \"fix:*\"",
    "fix:eslint": "eslint --max-warnings=0 --fix",
    "fix:knip": "knip --fix",
    "fix:markdownlint": "markdownlint --dot --fix .",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --cache --write .",
    "lint": "npm-run-all --continue-on-error \"lint:*\"",
    "lint:cspell": "cspell --cache --cache-location=node_modules/.cache/cspell/.cspellcache --cache-strategy=content --dot --no-progress \"**/*\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:knip": "knip",
    "lint:markdownlint": "markdownlint --dot .",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --cache --check .",
    "lint:tsc": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run"
  },
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@kachkaev/prettier-config",
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@changesets/config": "4.0.0",
    "@kachkaev/eslint-config-base": "1.2.0",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@kachkaev/prettier-config": "2.2.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "cspell": "10.2.0",
    "eslint": "9.39.5",
    "execa": "10.0.1",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "lint-staged": "17.4.1",
    "markdownlint-cli": "0.49.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.3.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
