{
  "name": "suppress-exit-code",
  "version": "3.2.0",
  "description": "Cross-platform CLI wrapper that runs any command and exits with zero",
  "keywords": [
    "cli",
    "exit-code",
    "ignore",
    "suppress"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kachkaev/suppress-exit-code.git"
  },
  "license": "MIT",
  "author": {
    "name": "Alexander Kachkaev",
    "url": "https://en.kachkaev.ru/"
  },
  "type": "module",
  "main": "main.js",
  "bin": "main.js",
  "files": [
    "LICENSE.md",
    "README.md",
    "main.js"
  ],
  "scripts": {
    "changesets:publish": "changeset publish",
    "changesets:version": "changeset version",
    "fix": "npm-run-all --continue-on-error \"fix:*\"",
    "fix:eslint": "eslint --max-warnings=0 --fix",
    "fix:knip": "knip --fix",
    "fix:markdownlint": "markdownlint --dot --fix .",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --cache --write .",
    "lint": "npm-run-all --continue-on-error \"lint:*\"",
    "lint:cspell": "cspell --cache --cache-location=node_modules/.cache/cspell/.cspellcache --cache-strategy=content --dot --no-progress \"**/*\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:knip": "knip",
    "lint:markdownlint": "markdownlint --dot .",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --cache --check .",
    "lint:tsc": "tsc --noEmit",
    "prepare": "node .husky/install.mjs",
    "test": "vitest run"
  },
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@kachkaev/prettier-config",
  "dependencies": {
    "cross-spawn": "7.0.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@changesets/config": "4.0.0",
    "@kachkaev/eslint-config-base": "1.2.0",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@kachkaev/prettier-config": "2.2.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "cspell": "10.0.1",
    "eslint": "9.39.5",
    "execa": "10.0.1",
    "husky": "9.1.7",
    "knip": "6.32.1",
    "lint-staged": "17.3.0",
    "markdownlint-cli": "0.49.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
